# Local-only tokens for compose + Pester download coverage.
# Copy to .env (gitignored). Empty values skip the token-download cases.
# CI does not load this file. Do not put a live token in the repo.

# IP2Location (https://lite.ip2location.com or a paid account)
IP2LOCATION_DOWNLOAD_TOKEN=
# Official file= package code you own (e.g. DB8BINIPV6, DB1LITEBINIPV6)
IP2LOCATION_DATABASE_CODE=DB8BINIPV6

# IPinfo MMDB (https://ipinfo.io/account/token). Code: lite (default), core, or plus.
IPINFO_DOWNLOAD_TOKEN=
IPINFO_DATABASE_CODE=lite

# MaxMind GeoLite2 (https://www.maxmind.com/en/accounts/current/license-key).
# Token is accountId:licenseKey. Official download tests skip when empty.
MAXMIND_DOWNLOAD_TOKEN=
MAXMIND_DATABASE_CODE=GeoLite2-Country
